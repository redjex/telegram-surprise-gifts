--- /dev/null
+++ b/submodules/TelegramUI/Components/Gifts/GiftDemoScreen/Sources/SurpriseGiftDemoScreen.swift
@@ -0,0 +1,232 @@
+import Foundation
+import UIKit
+import AsyncDisplayKit
+import Display
+import AccountContext
+import ComponentFlow
+import TelegramCore
+import TelegramPresentationData
+import PresentationDataUtils
+import GiftItemComponent
+import LottieComponent
+
+/// Explicitly local preview. It never invokes the confirmation's real transfer closure.
+public final class SurpriseGiftDemoScreen: ViewController {
+    private let context: AccountContext
+    private let gift: StarGift.UniqueGift
+    private let recipient: EnginePeer
+    private let automaticallySend: Bool
+    private let scrollView = UIScrollView()
+    private let card = UIView()
+    private let titleLabel = UILabel()
+    private let detailLabel = UILabel()
+    private let noticeLabel = UILabel()
+    private let actionButton = UIButton(type: .system)
+    private let sendButton = UIButton(type: .system)
+    private let giftView = ComponentView<Empty>()
+    private let boxView = ComponentView<Empty>()
+    private let playBox = ActionSlot<Void>()
+    private var store: SurpriseGiftDemoStore?
+    private var delivery: SurpriseGiftDemoStore.Delivery?
+    private let requestId = UUID()
+    private var revealAnimator: UIViewPropertyAnimator?
+    private var contentWidth: CGFloat = 0
+
+    public init(context: AccountContext, gift: StarGift.UniqueGift, recipient: EnginePeer, automaticallySend: Bool = false) {
+        self.context = context
+        self.gift = gift
+        self.recipient = recipient
+        self.automaticallySend = automaticallySend
+        let presentationData = context.sharedContext.currentPresentationData.with { $0 }
+        super.init(navigationBarPresentationData: NavigationBarPresentationData(presentationData: presentationData))
+        self.title = "Surprise Gift · Demo"
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: presentationData.strings.Common_Close, style: .plain, target: self, action: #selector(closePressed))
+    }
+
+    required public init(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override public func loadDisplayNode() {
+        self.displayNode = ASDisplayNode()
+        let presentationData = self.context.sharedContext.currentPresentationData.with { $0 }
+        self.displayNode.backgroundColor = presentationData.theme.list.blocksBackgroundColor
+        self.displayNode.view.addSubview(self.scrollView)
+        self.scrollView.addSubview(self.noticeLabel)
+        self.scrollView.addSubview(self.card)
+        self.scrollView.addSubview(self.sendButton)
+        self.card.backgroundColor = UIColor(rgb: 0x34464f)
+        self.card.layer.cornerRadius = 24
+        self.titleLabel.font = Font.semibold(20)
+        self.titleLabel.textColor = .white
+        self.titleLabel.textAlignment = .center
+        self.titleLabel.numberOfLines = 2
+        self.detailLabel.font = Font.regular(16)
+        self.detailLabel.textColor = UIColor.white.withAlphaComponent(0.8)
+        self.detailLabel.textAlignment = .center
+        self.detailLabel.numberOfLines = 0
+        self.noticeLabel.font = Font.regular(14)
+        self.noticeLabel.textAlignment = .center
+        self.noticeLabel.numberOfLines = 0
+        self.noticeLabel.textColor = presentationData.theme.list.itemSecondaryTextColor
+        self.noticeLabel.text = "Demo Mode · local recipient preview\nNo gifts, Stars or ownership are transferred."
+        self.actionButton.titleLabel?.font = Font.semibold(17)
+        self.actionButton.tintColor = .white
+        self.actionButton.backgroundColor = UIColor.black.withAlphaComponent(0.18)
+        self.actionButton.layer.cornerRadius = 22
+        self.actionButton.addTarget(self, action: #selector(actionPressed), for: .touchUpInside)
+        self.sendButton.titleLabel?.font = Font.semibold(17)
+        self.sendButton.setTitle("Send as a Surprise · Demo", for: .normal)
+        self.sendButton.tintColor = presentationData.theme.list.itemAccentColor
+        self.sendButton.addTarget(self, action: #selector(sendPressed), for: .touchUpInside)
+        self.card.addSubview(self.titleLabel)
+        self.card.addSubview(self.detailLabel)
+        self.card.addSubview(self.actionButton)
+        do {
+            let root = try FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true)
+            let url = root.appendingPathComponent("SurpriseGiftDemo/\(self.context.account.peerId.toInt64())/deliveries.json")
+            let store = try SurpriseGiftDemoStore(url: url)
+            self.store = store
+            if self.automaticallySend {
+                self.delivery = try store.send(requestId: self.requestId, sender: String(self.context.account.peerId.toInt64()), recipient: self.recipientKey, gift: self.demoGift)
+            } else {
+                self.delivery = store.deliveries(for: self.recipientKey).last(where: { $0.gift.id == self.gift.slug })
+            }
+        } catch {
+            self.noticeLabel.text = "Demo storage could not be read. Your existing data has been preserved."
+            self.sendButton.isEnabled = false
+        }
+        self.render()
+    }
+
+    private var recipientKey: String {
+        return String(self.recipient.id.toInt64())
+    }
+
+    private var demoGift: SurpriseGiftDemoStore.Gift {
+        var model = "—"
+        var backdrop = "—"
+        var symbol = "—"
+        for attribute in self.gift.attributes {
+            switch attribute {
+            case let .model(name, _, _, _): model = name
+            case let .backdrop(name, _, _, _, _, _, _): backdrop = name
+            case let .pattern(name, _, _): symbol = name
+            case .originalInfo: break
+            }
+        }
+        return SurpriseGiftDemoStore.Gift(id: self.gift.slug, title: "\(self.gift.title) #\(self.gift.number)", model: model, backdrop: backdrop, symbol: symbol)
+    }
+
+    @objc private func closePressed() {
+        self.revealAnimator?.stopAnimation(true)
+        self.dismiss()
+    }
+
+    override public func viewDidDisappear(_ animated: Bool) {
+        super.viewDidDisappear(animated)
+        self.revealAnimator?.stopAnimation(true)
+        self.revealAnimator = nil
+        self.render()
+    }
+
+    @objc private func sendPressed() {
+        guard self.store != nil else { return }
+        let data = self.context.sharedContext.currentPresentationData.with { $0 }
+        let name = self.recipient.displayTitle(strings: data.strings, displayOrder: data.nameDisplayOrder)
+        let alert = UIAlertController(title: "Confirm Demo Delivery", message: "Create a local surprise for \(name)? This does not transfer your collectible or spend Stars.", preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: data.strings.Common_Cancel, style: .cancel))
+        alert.addAction(UIAlertAction(title: "Send Demo", style: .default, handler: { [weak self] _ in
+            guard let self, let store = self.store else { return }
+            do {
+                self.delivery = try store.send(requestId: self.requestId, sender: String(self.context.account.peerId.toInt64()), recipient: self.recipientKey, gift: self.demoGift)
+                self.render()
+            } catch {
+                self.showError()
+            }
+        }))
+        self.present(alert, animated: true)
+    }
+
+    @objc private func actionPressed() {
+        guard let delivery = self.delivery, let store = self.store, self.revealAnimator == nil else { return }
+        if delivery.opened {
+            let gift = delivery.gift
+            let alert = UIAlertController(title: gift.title, message: "Model: \(gift.model)\nBackdrop: \(gift.backdrop)\nSymbol: \(gift.symbol)\n\nLocal Demo · ownership unchanged", preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "Close", style: .default))
+            self.present(alert, animated: true)
+            return
+        }
+        do {
+            self.delivery = try store.unwrap(id: delivery.id, recipient: self.recipientKey)
+        } catch {
+            self.showError()
+            return
+        }
+        if UIAccessibility.isReduceMotionEnabled {
+            self.render()
+            return
+        }
+        self.actionButton.isEnabled = false
+        self.playBox.invoke(Void())
+        let animator = UIViewPropertyAnimator(duration: 1.2, curve: .easeInOut) { [weak self] in
+            self?.boxView.view?.alpha = 0
+            self?.boxView.view?.transform = CGAffineTransform(scaleX: 1.2, y: 1.2)
+            self?.giftView.view?.alpha = 1
+        }
+        animator.addCompletion { [weak self] _ in
+            self?.revealAnimator = nil
+            self?.render()
+        }
+        self.revealAnimator = animator
+        animator.startAnimation()
+    }
+
+    private func showError() {
+        let alert = UIAlertController(title: "Demo could not be saved", message: "The operation was not completed. Try again after checking available storage.", preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default))
+        self.present(alert, animated: true)
+    }
+
+    private func render() {
+        let opened = self.delivery?.opened == true
+        self.titleLabel.text = self.delivery == nil ? self.demoGift.title : "Gift from you"
+        self.detailLabel.text = opened ? "\(self.demoGift.title)\n\nModel  \(self.demoGift.model)\nBackdrop  \(self.demoGift.backdrop)\nSymbol  \(self.demoGift.symbol)" : (self.delivery == nil ? "Choose Send as a Surprise to create a local delivery." : "Special surprise")
+        self.actionButton.setTitle(opened ? "View" : "Unwrap", for: .normal)
+        self.actionButton.isHidden = self.delivery == nil
+        self.actionButton.isEnabled = true
+        self.sendButton.isHidden = self.delivery != nil
+        self.boxView.view?.transform = .identity
+        self.boxView.view?.alpha = self.delivery != nil && !opened ? 1 : 0
+        self.giftView.view?.alpha = self.delivery == nil || opened ? 1 : 0
+    }
+
+    override public func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        let top = self.navigationLayout(layout: layout).navigationFrame.maxY
+        self.scrollView.frame = CGRect(x: layout.safeInsets.left, y: top, width: layout.size.width - layout.safeInsets.left - layout.safeInsets.right, height: layout.size.height - top)
+        let width = self.scrollView.bounds.width
+        self.noticeLabel.frame = CGRect(x: 16, y: 12, width: width - 32, height: 54)
+        let cardWidth = min(303, width - 40)
+        self.card.frame = CGRect(x: (width - cardWidth) / 2, y: 82, width: cardWidth, height: 450)
+        self.titleLabel.frame = CGRect(x: 12, y: 202, width: cardWidth - 24, height: 52)
+        self.detailLabel.frame = CGRect(x: 12, y: 258, width: cardWidth - 24, height: 126)
+        self.actionButton.frame = CGRect(x: (cardWidth - 112) / 2, y: 394, width: 112, height: 44)
+        self.sendButton.frame = CGRect(x: 16, y: 548, width: width - 32, height: 50)
+        self.scrollView.contentSize = CGSize(width: width, height: 614 + layout.intrinsicInsets.bottom)
+        if self.contentWidth != cardWidth {
+            self.contentWidth = cardWidth
+            let data = self.context.sharedContext.currentPresentationData.with { $0 }
+            let size = CGSize(width: 180, height: 180)
+            let _ = self.giftView.update(transition: .immediate, component: AnyComponent(GiftItemComponent(context: self.context, theme: data.theme, strings: data.strings, subject: .uniqueGift(gift: self.gift, price: nil), mode: .thumbnail)), environment: {}, containerSize: size)
+            let _ = self.boxView.update(transition: .immediate, component: AnyComponent(LottieComponent(content: LottieComponent.AppBundleContent(name: "GiftUnpack"), startingPosition: .begin, size: size, playOnce: self.playBox)), environment: {}, containerSize: size)
+            for component in [self.giftView, self.boxView] {
+                if let view = component.view {
+                    if view.superview == nil { self.card.insertSubview(view, at: 0) }
+                    view.frame = CGRect(x: (cardWidth - 180) / 2, y: 16, width: 180, height: 180)
+                }
+            }
+            if self.revealAnimator == nil { self.render() }
+        }
+    }
+}
