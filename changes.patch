@@ -0,0 +1,130 @@
+import Foundation
+
+/// Local-only prototype domain. Does not call Telegram payments or transfer APIs.
+/// UI integration must use a separate demo entry point and identify it as Demo Mode.
+public final class SurpriseGiftDemoStore {
+    public struct Gift: Codable, Equatable {
+        public let id: String
+        public let title: String
+        public let model: String
+        public let backdrop: String
+        public let symbol: String
+
+        public init(id: String, title: String, model: String, backdrop: String, symbol: String) {
+            self.id = id
+            self.title = title
+            self.model = model
+            self.backdrop = backdrop
+            self.symbol = symbol
+        }
+    }
+
+    public struct Delivery: Codable, Equatable {
+        public let id: UUID
+        public let sender: String
+        public let recipient: String
+        public let gift: Gift
+        public private(set) var opened: Bool
+
+        fileprivate init(id: UUID, sender: String, recipient: String, gift: Gift) {
+            self.id = id
+            self.sender = sender
+            self.recipient = recipient
+            self.gift = gift
+            self.opened = false
+        }
+
+        fileprivate mutating func reveal() {
+            self.opened = true
+        }
+    }
+
+    public enum StoreError: Error {
+        case invalidParticipants
+        case unknownDelivery
+        case wrongRecipient
+        case conflictingRequest
+        case unsupportedVersion
+    }
+
+    private struct Archive: Codable {
+        let version: Int
+        var deliveries: [Delivery]
+    }
+
+    private let url: URL
+    private let lock = NSLock()
+    private var archive: Archive
+
+    /// Caller supplies an account-scoped application-support URL, never Postbox.
+    /// Corrupt/unsupported data is surfaced to the caller, never silently replaced.
+    public init(url: URL) throws {
+        self.url = url
+        if FileManager.default.fileExists(atPath: url.path) {
+            self.archive = try JSONDecoder().decode(Archive.self, from: Data(contentsOf: url))
+            guard self.archive.version == 1 else {
+                throw StoreError.unsupportedVersion
+            }
+        } else {
+            self.archive = Archive(version: 1, deliveries: [])
+        }
+    }
+
+    public func deliveries(for participant: String) -> [Delivery] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.archive.deliveries.filter { $0.sender == participant || $0.recipient == participant }
+    }
+
+    /// Call only after confirmation. Cancellation creates no delivery.
+    /// Reuse the confirmation's request ID to make repeated taps idempotent.
+    @discardableResult
+    public func send(requestId: UUID, sender: String, recipient: String, gift: Gift) throws -> Delivery {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard !sender.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              !recipient.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+              sender != recipient else {
+            throw StoreError.invalidParticipants
+        }
+        if let delivery = self.archive.deliveries.first(where: { $0.id == requestId }) {
+            guard delivery.sender == sender, delivery.recipient == recipient, delivery.gift == gift else {
+                throw StoreError.conflictingRequest
+            }
+            return delivery
+        }
+        let delivery = Delivery(id: requestId, sender: sender, recipient: recipient, gift: gift)
+        var next = self.archive
+        next.deliveries.append(delivery)
+        try self.commit(next)
+        return delivery
+    }
+
+    /// Persist before playing the reveal. Animation is transient: restarting or
+    /// recycling a cell must render the durable revealed state, not replay it.
+    @discardableResult
+    public func unwrap(id: UUID, recipient: String) throws -> Delivery {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard let index = self.archive.deliveries.firstIndex(where: { $0.id == id }) else {
+            throw StoreError.unknownDelivery
+        }
+        guard self.archive.deliveries[index].recipient == recipient else {
+            throw StoreError.wrongRecipient
+        }
+        if self.archive.deliveries[index].opened {
+            return self.archive.deliveries[index]
+        }
+        var next = self.archive
+        next.deliveries[index].reveal()
+        try self.commit(next)
+        return next.deliveries[index]
+    }
+
+    private func commit(_ next: Archive) throws {
+        let data = try JSONEncoder().encode(next)
+        try FileManager.default.createDirectory(at: self.url.deletingLastPathComponent(), withIntermediateDirectories: true)
+        try data.write(to: self.url, options: .atomic)
+        self.archive = next
+    }
+}
